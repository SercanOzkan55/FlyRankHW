# Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_public_key

# Port the API listens on
PORT=3000

# LLM provider. OpenRouter and Ollama both use this OpenAI-compatible shape.
# OpenRouter: https://openrouter.ai/api/v1 | key from OpenRouter | openrouter/free
# Ollama:     http://localhost:11434/v1  | ollama              | gemma3:1b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Development and emergency controls
LLM_STUB=1
LLM_ENABLED=true
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
